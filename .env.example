# PayUp environment - copy to .env and fill in. NEVER commit .env.

# --- Invoice source (who's overdue) ---
# quickbooks (default, works globally) or wave (US/Canada only).
PAYUP_SOURCE=quickbooks

# --- QuickBooks Online (default source) ---
# Create a free Intuit developer account + sandbox company at
# https://developer.intuit.com, then mint an access token from the OAuth
# Playground (scope: com.intuit.quickbooks.accounting). The realm id is your
# sandbox company id. Access tokens expire hourly; for an always-on bot set ALL
# THREE refresh values below and PayUp renews the token before each daily run.
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# Required together for unattended token refresh (always-on bot):
QBO_REFRESH_TOKEN=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Which Intuit host to use: sandbox (default) or production (your real company).
PAYUP_QBO_ENV=sandbox

# --- Wave Accounting (alternative source; US/Canada businesses only) ---
# Only needed if PAYUP_SOURCE=wave. Full-access GraphQL token + business id.
WAVE_API_TOKEN=
WAVE_BUSINESS_ID=

# --- Gmail (outbound send + drafts) ---
# Run: python engine/scripts/gmail_oauth_setup.py  (one-shot consent -> config/token.json)
# Scopes: gmail.send, gmail.readonly, gmail.compose (compose powers "draft" in
# Slack). If you set PayUp up before draft support existed, delete
# config/token.json and re-run the setup script to re-consent to gmail.compose.
# Path to the OAuth client secret you downloaded from Google Cloud Console:
GMAIL_OAUTH_CLIENT=config/oauth_client.json
# Where the resulting user token is stored (gitignored):
GMAIL_TOKEN_PATH=config/token.json

# --- Slack bot (operational surface; Socket Mode = no public URL) ---
# Create an app at https://api.slack.com/apps, enable Socket Mode.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Channel the bot posts the overdue batch into:
SLACK_CHANNEL=#payup

# --- Reserved: planned v1.1 LLM draft-polish. NOT wired yet; has no effect. ---
ANTHROPIC_API_KEY=

# --- Behaviour ---
# Escalation no-nag gap: never chase the same invoice twice within this many days.
PAYUP_MIN_GAP_DAYS=7
# How far back to search Gmail for prior reminders (escalation history window).
# Wider than the no-nag gap on purpose, so prior-count escalation can fire.
PAYUP_HISTORY_DAYS=90
# Optional escalation tuning (override config/escalation.yml and the defaults):
# PAYUP_GENTLE_MAX_DAYS=14
# PAYUP_FIRM_MAX_DAYS=30
# PAYUP_FINAL_MIN_PRIORS=2
# Who the reminders are signed by:
PAYUP_SENDER=Accounts
PAYUP_BUSINESS_NAME=our team
# Daily check time, 24h local, HH:MM
PAYUP_DAILY_AT=09:00
# Hard safety: set to 1 only when you intend real sends. Default dry-run.
PAYUP_LIVE=0
# Where the run ledger (powers /chase-status) is written. Gitignored.
PAYUP_LEDGER=ledger/runs.jsonl
# Optional path to an escalation policy YAML (env vars above still override it).
PAYUP_ESCALATION_CONFIG=config/escalation.yml
# Optional path to the reminder templates YAML (subject/body per tier). Omitted
# or missing fields fall back to the built-in defaults.
PAYUP_TEMPLATES_CONFIG=config/templates.yml
